# Copy to tools/deploy.env and fill in. Not committed — it holds a password.

SSH_HOST=example.com
SSH_USER=cpaneluser
SSH_PORT=22

# The cPanel Python App's "Application root", as an absolute path.
APP_ROOT=/home/cpaneluser/dictionary

# cPanel prefixes both with the account name.
DB_NAME=cpaneluser_dictionary
DB_USER=cpaneluser_dict
DB_PASSWORD=

# Used for the post-deploy health check.
SITE_URL=https://dictionary.example.com
