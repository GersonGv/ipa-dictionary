# Copy to .env on the server and fill in. Never commit the real .env.
# cPanel prefixes every database and user with your account name.
DATABASE_URL=mysql+pymysql://cpaneluser_dict:password@localhost/cpaneluser_dictionary?charset=utf8mb4

# Canonical public origin, used for <link rel=canonical> and the sitemap.
SITE_URL=https://dictionary.example.com
SITE_NAME=IPA Dictionary

# "production" turns off Flask debug and enables long cache headers on /static.
FLASK_ENV=production
